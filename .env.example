# SMTP settings for the daily job digest (tools/daily_digest.py).
# Copy to .env and fill in. Never commit .env.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional. Digest ATS dork channel (same queries as /scrape). If unset, digest
# still runs SEEK + preferred_companies boards and notes that dorks were skipped.
BRAVE_SEARCH_API_KEY=
