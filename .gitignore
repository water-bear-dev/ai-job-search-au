*.jpg
*.jpeg
*.png
!cover_letters/OpenFonts/fonts/**

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Memory files (Claude Code user-specific)
.claude/projects/

# Skills lock (auto-generated)
skills-lock.json

# Personal workspace (candidate-specific — do not share)
cv/
skills/
AGENTS.md
**/job-application-assistant/**

# Tracked profile templates (safe to commit — placeholders only)
!examples/profile/
!examples/profile/**

# Personal application output (generated by /apply — do not share)
applied_jobs/
cover_letters/cover_*.tex
cover_letters/Cover_*.tex
cover_letters/*/*.tex

# documents/ subfolder contents are personal — only README and folder structure are tracked
documents/cv/**
documents/linkedin/**
documents/diplomas/**
documents/references/**
documents/applications/**
documents/postings/**
!documents/**/.gitkeep

# Personal job search tracking
job_search_tracker.csv
job_search_tracker_trash.csv
tracker/.data_revision
tracker/latex-cleanup.log

# Document output preference (populated by /setup)
config/document_output.json

# Agent session handoff (local only — copy from agent_handoff.example.md)
agent_handoff.md

# Upskill reports (personal output)
upskill/*.md
**/upskill/report-*.md

# Agent usage logs (allow Antigravity adapter dirs)
.agents/*
!.agents/skills/
!.agents/skills/**
!.agents/workflows/
!.agents/workflows/**
